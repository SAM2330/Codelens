# Server Configuration
PORT=5000

# GitHub Integration
GITHUB_TOKEN=your_github_personal_access_token_here

# Google Gemini API (Required for Code Embeddings)
GEMINI_API_KEY=your_gemini_api_key_here

# PostgreSQL / Supabase Database Connection
# Option 1: Full Connection String (Recommended for Supabase)
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-SUPABASE-PROJECT-REF].supabase.co:5432/postgres

# Option 2: Individual Connection Parameters
PGHOST=db.[YOUR-SUPABASE-PROJECT-REF].supabase.co
PGPORT=5432
PGUSER=postgres
PGPASSWORD=your_database_password_here
PGDATABASE=postgres

# Supabase API (Optional / Future use)
SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here
